stateDiagram-v2
    [*] --> notCreated

    notCreated --> creating : Добавить предмет
    creating --> checking : Сохранить
    checking --> creating : Ошибки в данных
    checking --> active : Данные корректны

    active --> editing : Изменить предмет
    editing --> checking : Сохранить изменения
    editing --> active : Отменить изменения

    active --> confirm : Удалить предмет
    confirm --> active : Отменить удаление
    confirm --> [*] : Удалить предмет

    state "НеСоздан" as notCreated
    state "Создание" as creating
    state "ПроверкаДанных" as checking
    state "Активен" as active
