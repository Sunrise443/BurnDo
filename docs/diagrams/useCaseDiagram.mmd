flowchart TB
    subgraph rowStarosta[" "]
        direction LR
        starosta[Староста]
        ucAdd([Добавить или удалить пользователя из группы])
        ucAssign([Назначить замстаросты])
        ucList([Посмотреть список группы])
        starosta --> ucAdd
        starosta --> ucAssign
        starosta --> ucList
    end

    subgraph rowDeputy[" "]
        direction LR
        deputy[Замстаросты]
        ucEditTask([Редактировать задание])
        ucEditSubject([Редактировать информацию о предмете])
        ucMakeSchedule([Составить расписание занятий])
        deputy --> ucEditTask
        deputy --> ucEditSubject
        deputy --> ucMakeSchedule
    end

    subgraph rowStudent[" "]
        direction LR
        student[Студент]
        ucAccount([Регистрация, вход, выход, удаление ака и сброс пароля])
        ucViewSchedule([Посмотреть расписание])
        ucViewSubject([Посмотреть информацию о предмете])
        ucViewTask([Посмотреть задание])
        student --> ucAccount
        student --> ucViewSchedule
        student --> ucViewSubject
        student --> ucViewTask
    end

    starosta ==> deputy
    deputy ==> student

    style rowStarosta fill:none,stroke:none
    style rowDeputy fill:none,stroke:none
    style rowStudent fill:none,stroke:none
